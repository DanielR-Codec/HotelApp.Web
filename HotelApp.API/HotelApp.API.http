@baseUrl = http://localhost:5087

###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@hotel.com",
  "password": "Admin123*"
}

###
@token = PEGUE_AQUI_EL_TOKEN

###
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/hotels?includeInactive=false
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Hotel Caribe",
  "address": "Av. George Washington 100",
  "city": "Santo Domingo",
  "phone": "809-555-1234",
  "email": "info@hotelcaribe.com"
}

###
PUT {{baseUrl}}/api/hotels/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Hotel Caribe",
  "address": "Av. George Washington 100",
  "city": "Santo Domingo",
  "phone": "809-555-1234",
  "email": "reservas@hotelcaribe.com",
  "isActive": true
}

###
DELETE {{baseUrl}}/api/hotels/1
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/blocks?hotelId=1
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/blocks
Authorization: Bearer {{token}}
Content-Type: application/json

{ "hotelId": 1, "name": "Torre A", "description": "Frente al mar" }

###
GET {{baseUrl}}/api/floors?hotelId=1&blockId=1
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/floors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "blockId": 1, "number": 1, "description": "Primer piso" }

###
GET {{baseUrl}}/api/roomtypes
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/roomtypes
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Doble", "maxCapacity": 2, "baseRate": 3500.00 }

###
GET {{baseUrl}}/api/rooms?hotelId=1
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/rooms
Authorization: Bearer {{token}}
Content-Type: application/json

{ "number": "101", "floorId": 1, "roomTypeId": 1 }

###
PATCH {{baseUrl}}/api/rooms/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "En Limpieza" }

###
GET {{baseUrl}}/api/rooms/available?checkIn=2026-12-20&checkOut=2026-12-23&guests=2&hotelId=1
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/api/rooms/1
Authorization: Bearer {{token}}
