@model HotelApp.Web.Models.Hotels.HotelIndexViewModel
@{
    ViewData["Title"] = "Hoteles";
    var isAdmin = User.IsAdministrator();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Gestión de hoteles</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Nuevo hotel</a>
    }
</div>

<form method="get" class="d-flex align-items-center gap-3 mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true"
               @(Model.IncludeInactive ? "checked" : "") onchange="this.form.submit()" />
        <label class="form-check-label" for="includeInactive">Mostrar inactivos</label>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No hay hoteles registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Ciudad</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hotel in Model.Items)
                {
                    <tr class="@(hotel.IsActive ? "" : "text-muted")">
                        <td class="fw-semibold">@hotel.Name</td>
                        <td>@hotel.Address</td>
                        <td>@hotel.City</td>
                        <td>@hotel.Phone</td>
                        <td>@(string.IsNullOrEmpty(hotel.Email) ? "—" : hotel.Email)</td>
                        <td>@await Html.PartialAsync("_StatusBadge", (hotel.IsActive, "Activo", "Inactivo"))</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Blocks" asp-action="Index" asp-route-hotelId="@hotel.HotelId" class="btn btn-sm btn-outline-secondary">Bloques</a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@hotel.HotelId" class="btn btn-sm btn-outline-primary">Editar</a>
                                @if (hotel.IsActive)
                                {
                                    <a asp-action="Delete" asp-route-id="@hotel.HotelId" class="btn btn-sm btn-outline-danger">Desactivar</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
