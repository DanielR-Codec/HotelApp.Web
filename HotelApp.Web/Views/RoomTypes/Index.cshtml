@model List<HotelApp.DAL.Models.dbo.RoomType>
@{
    ViewData["Title"] = "Tipos de habitación";
    var isAdmin = User.IsAdministrator();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Mantenimiento de tipos de habitación</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Nuevo tipo</a>
    }
</div>

@if (!isAdmin)
{
    <p class="text-muted small">Solo un Administrador puede crear tipos o cambiar las tarifas (RN-014).</p>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay tipos de habitación registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th class="text-center">Capacidad máxima</th>
                    <th class="text-end">Tarifa base / noche</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var roomType in Model)
                {
                    <tr>
                        <td class="fw-semibold">@roomType.Name</td>
                        <td class="text-center">@roomType.MaxCapacity persona(s)</td>
                        <td class="text-end">RD$ @roomType.BaseRate.ToString("N2")</td>
                        @if (isAdmin)
                        {
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@roomType.RoomTypeId" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@roomType.RoomTypeId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
